<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KasKita - Web Kas Kelas Transparan v3.0</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome CDN for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- SheetJS CDN for Direct Excel (.xlsx) Export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col justify-between">

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 flex items-center p-4 mb-4 text-slate-800 bg-white rounded-xl shadow-2xl border border-slate-100 max-w-md">
        <div id="toast-icon" class="inline-flex items-center justify-center flex-shrink-0 w-10 h-10 text-emerald-500 bg-emerald-100 rounded-lg">
            <i class="fas fa-check-circle text-lg"></i>
        </div>
        <div id="toast-msg" class="ml-3 text-sm font-semibold text-slate-700">Notifikasi</div>
    </div>

    <!-- Header / Navbar -->
    <header id="main-header" class="hidden bg-white border-b border-slate-200 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-emerald-600 text-white p-2 rounded-xl shadow-md">
                    <i class="fas fa-wallet text-xl"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg text-slate-900 leading-tight">KasKita</h1>
                    <p class="text-xs text-slate-500 font-medium">Manajemen Kas Transparan v3.0</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-3">
                <div class="bg-slate-100 px-3 py-1.5 rounded-lg flex items-center space-x-2 border border-slate-200">
                    <i class="fas fa-user-circle text-emerald-600"></i>
                    <span id="nav-username" class="text-xs font-semibold text-slate-700">Bendahara</span>
                </div>
                <button onclick="handleLogout()" class="text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 px-3 py-1.5 rounded-lg transition-colors border border-rose-200">
                    <i class="fas fa-sign-out-alt mr-1"></i>Keluar
                </button>
            </div>
        </div>
    </header>

    <main class="flex-grow flex items-center justify-center p-4">

        <!-- PAGE 1: AUTH (LOGIN & REGISTER) -->
        <section id="page-auth" class="w-full max-w-md bg-white p-8 rounded-2xl shadow-xl border border-slate-100 my-8">
            <div class="text-center mb-8">
                <div class="inline-block bg-emerald-100 text-emerald-600 p-4 rounded-2xl mb-3 shadow-inner">
                    <i class="fas fa-user-shield text-3xl"></i>
                </div>
                <h2 id="auth-title" class="text-2xl font-bold text-slate-900">Login Bendahara</h2>
                <p id="auth-subtitle" class="text-sm text-slate-500 mt-1">Masuk untuk mengelola keuangan kelas</p>
            </div>

            <!-- Login Form -->
            <form id="form-login" onsubmit="handleLogin(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Username / Email</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <i class="fas fa-envelope"></i>
                        </span>
                        <input type="text" id="login-user" required placeholder="Masukkan username" class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Kata Sandi</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input type="password" id="login-pass" required placeholder="••••••••" class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all">
                    </div>
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 rounded-xl shadow-lg shadow-emerald-200 transition-all text-sm flex items-center justify-center space-x-2">
                    <span>Masuk Aplikasi</span>
                    <i class="fas fa-arrow-right text-xs"></i>
                </button>
            </form>

            <!-- Register Form -->
            <form id="form-register" onsubmit="handleRegister(event)" class="space-y-4 hidden">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Lengkap Bendahara</label>
                    <input type="text" id="reg-name" required placeholder="Contoh: Budi Santoso" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Username / Email</label>
                    <input type="text" id="reg-user" required placeholder="Buat username" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Kata Sandi</label>
                    <input type="password" id="reg-pass" required placeholder="Minimal 6 karakter" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all">
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 rounded-xl shadow-lg shadow-emerald-200 transition-all text-sm">
                    Buat Akun Baru
                </button>
            </form>

            <div class="mt-6 text-center border-t border-slate-100 pt-4">
                <p id="toggle-auth-text" class="text-xs text-slate-500">
                    Belum punya akun? 
                    <button type="button" onclick="switchAuthMode('register')" class="text-emerald-600 font-bold hover:underline">Daftar Akun</button>
                </p>
            </div>
        </section>


        <!-- PAGE 2: WELCOME & QUOTES KEJUJURAN -->
        <section id="page-quotes" class="hidden w-full max-w-2xl bg-white p-8 md:p-12 rounded-3xl shadow-2xl border border-slate-100 text-center my-8 relative overflow-hidden">
            <div class="relative z-10">
                <div class="inline-flex items-center justify-center w-20 h-20 bg-emerald-100 text-emerald-600 rounded-3xl mb-6 shadow-inner transform hover:scale-105 transition-transform">
                    <i class="fas fa-hand-holding-heart text-4xl"></i>
                </div>

                <span class="inline-block px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-full mb-3 uppercase tracking-wider">Amanah & Kejujuran</span>
                
                <h2 id="welcome-user-text" class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-4">
                    Selamat Datang, Bendahara!
                </h2>

                <div class="bg-slate-50 p-6 md:p-8 rounded-2xl border border-slate-200 my-6 shadow-sm relative">
                    <i class="fas fa-quote-left text-2xl text-emerald-300 absolute top-4 left-4"></i>
                    <p class="text-base md:text-lg text-slate-700 italic font-medium leading-relaxed px-6">
                        "Kejujuran adalah fondasi utama dalam mengelola uang kas bersama. Transparansi menciptakan kepercayaan, dan integritas menjaga kehormatan seorang pengelola."
                    </p>
                    <i class="fas fa-quote-right text-2xl text-emerald-300 absolute bottom-4 right-4"></i>
                </div>

                <button onclick="goToDashboard()" class="inline-flex items-center space-x-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-8 py-3.5 rounded-2xl shadow-xl shadow-emerald-200 hover:shadow-2xl transition-all">
                    <span>Lanjut ke Penginputan Kas</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </section>


        <!-- PAGE 3: DASHBOARD PENGINPUTAN KAS & MANAJEMEN -->
        <section id="page-dashboard" class="hidden w-full max-w-7xl mx-auto space-y-6 my-4">

            <!-- Stats Bar -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                    <div class="p-3 bg-emerald-100 text-emerald-600 rounded-xl">
                        <i class="fas fa-users text-2xl"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Total Anggota</p>
                        <h3 id="stat-total-students" class="text-xl font-bold text-slate-800">0 Mahasiswa</h3>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                    <div class="p-3 bg-emerald-100 text-emerald-600 rounded-xl">
                        <i class="fas fa-arrow-down text-2xl"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Total Uang Masuk</p>
                        <h3 id="stat-total-income" class="text-xl font-bold text-emerald-600">Rp 0</h3>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                    <div class="p-3 bg-rose-100 text-rose-600 rounded-xl">
                        <i class="fas fa-arrow-up text-2xl"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Total Pengeluaran</p>
                        <h3 id="stat-total-expense" class="text-xl font-bold text-rose-600">Rp 0</h3>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                    <div class="p-3 bg-blue-100 text-blue-600 rounded-xl">
                        <i class="fas fa-wallet text-2xl"></i>
                    </div>
                    <div>
                        <p class="text-xs text-slate-500 font-medium">Saldo Kas Bersih</p>
                        <h3 id="stat-total-balance" class="text-xl font-bold text-blue-600">Rp 0</h3>
                    </div>
                </div>
            </div>

            <!-- Tab Navigation & Actions -->
            <div class="bg-white p-2 rounded-2xl border border-slate-200 shadow-sm flex flex-wrap items-center justify-between gap-2">
                <div class="flex flex-wrap gap-1">
                    <button onclick="switchTab('input')" id="tab-btn-input" class="px-4 py-2.5 rounded-xl font-semibold text-xs transition-all flex items-center space-x-2 bg-emerald-600 text-white shadow-md">
                        <i class="fas fa-edit"></i>
                        <span>Input Kas / Transaksi</span>
                    </button>
                    <button onclick="switchTab('history')" id="tab-btn-history" class="px-4 py-2.5 rounded-xl font-semibold text-xs transition-all flex items-center space-x-2 text-slate-600 hover:bg-slate-100">
                        <i class="fas fa-history"></i>
                        <span>Laporan Transparansi</span>
                    </button>
                    <button onclick="switchTab('rekap')" id="tab-btn-rekap" class="px-4 py-2.5 rounded-xl font-semibold text-xs transition-all flex items-center space-x-2 text-slate-600 hover:bg-slate-100">
                        <i class="fas fa-calendar-alt"></i>
                        <span>Rekap Mingguan</span>
                    </button>
                    <button onclick="switchTab('students')" id="tab-btn-students" class="px-4 py-2.5 rounded-xl font-semibold text-xs transition-all flex items-center space-x-2 text-slate-600 hover:bg-slate-100">
                        <i class="fas fa-user-plus"></i>
                        <span>Data Mahasiswa</span>
                    </button>
                </div>

                <button onclick="openExportModal()" class="w-full sm:w-auto bg-emerald-700 hover:bg-emerald-800 text-white px-4 py-2.5 rounded-xl font-semibold text-xs transition-all shadow-md flex items-center justify-center space-x-2">
                    <i class="fas fa-file-excel text-sm"></i>
                    <span>Ekspor ke Excel (.xlsx)</span>
                </button>
            </div>


            <!-- TAB 1: FORM PENGINPUTAN KAS MINGGUAN & PENGELUARAN -->
            <div id="tab-content-input" class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-6">
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Form Transaksi Kas Kelas</h3>
                    <p class="text-xs text-slate-500">Pilih jenis penginputan kas mingguan atau pencatatan pengeluaran uang kas.</p>
                </div>

                <!-- Input Type Toggle -->
                <div class="flex space-x-4 border-b border-slate-200 pb-3">
                    <label class="flex items-center space-x-2 cursor-pointer">
                        <input type="radio" name="entry-type" value="INCOME_BATCH" checked onchange="toggleEntryTypeMode()" class="text-emerald-600 focus:ring-emerald-500">
                        <span class="text-xs font-bold text-slate-800">Pembayaran Kas Mingguan (Pemasukan)</span>
                    </label>
                    <label class="flex items-center space-x-2 cursor-pointer">
                        <input type="radio" name="entry-type" value="EXPENSE" onchange="toggleEntryTypeMode()" class="text-rose-600 focus:ring-rose-500">
                        <span class="text-xs font-bold text-slate-800">Pengeluaran Uang Kas</span>
                    </label>
                </div>

                <!-- FORM 1A: BATCH KAS MAHASISWA -->
                <div id="form-container-income" class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 bg-slate-50 rounded-xl border border-slate-200">
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Pembayaran Kas</label>
                            <input type="date" id="input-date" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-700 mb-1">Nominal Standard (Rp)</label>
                            <input type="number" id="input-nominal-default" value="5000" min="0" step="500" placeholder="5000" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                        </div>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <label class="text-sm font-bold text-slate-800">Daftar Mahasiswa (Centang jika LUNAS):</label>
                            <div class="flex items-center space-x-2 text-xs">
                                <button onclick="toggleSelectAllStudents(true)" class="text-emerald-600 font-semibold hover:underline">Pilih Semua</button>
                                <span class="text-slate-300">|</span>
                                <button onclick="toggleSelectAllStudents(false)" class="text-slate-500 font-semibold hover:underline">Batalkan Semua</button>
                            </div>
                        </div>

                        <div id="student-checkbox-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 max-h-80 overflow-y-auto p-2 custom-scrollbar">
                            <!-- Populated by JS -->
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-100 flex justify-end">
                        <button onclick="saveBatchKas()" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-6 py-2.5 rounded-xl shadow-lg shadow-emerald-200 transition-all text-sm flex items-center justify-center space-x-2">
                            <i class="fas fa-save"></i>
                            <span>Simpan Data Kas Mingguan</span>
                        </button>
                    </div>
                </div>

                <!-- FORM 1B: PENGELUARAN KAS -->
                <div id="form-container-expense" class="space-y-4 hidden">
                    <form onsubmit="handleSaveExpense(event)" class="space-y-4">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-4 bg-rose-50/50 rounded-xl border border-rose-100">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal Pengeluaran</label>
                                <input type="date" id="expense-date" required class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-rose-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Kategori Pengeluaran</label>
                                <select id="expense-category" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-rose-500">
                                    <option value="Perlengkapan Kelas">Perlengkapan Kelas (Spidol/Penghapus)</option>
                                    <option value="Fotokopi & Modul">Fotokopi & Modul Praktikum</option>
                                    <option value="Acara & Event Kelas">Acara & Event Kelas</option>
                                    <option value="Konsumsi">Konsumsi</option>
                                    <option value="Lain-lain">Lain-lain</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Nominal Pengeluaran (Rp)</label>
                                <input type="number" id="expense-nominal" required min="500" step="500" placeholder="Contoh: 15000" class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-rose-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Keterangan / Keperluan</label>
                                <input type="text" id="expense-note" required placeholder="Beli spidol boardmarker 2 pcs..." class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-rose-500">
                            </div>
                        </div>

                        <div class="pt-2 flex justify-end">
                            <button type="submit" class="w-full sm:w-auto bg-rose-600 hover:bg-rose-700 text-white font-bold px-6 py-2.5 rounded-xl shadow-lg shadow-rose-200 transition-all text-sm flex items-center justify-center space-x-2">
                                <i class="fas fa-minus-circle"></i>
                                <span>Catat Pengeluaran Kas</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>


            <!-- TAB 2: LAPORAN TRANSPARANSI (HISTORY TABLE) -->
            <div id="tab-content-history" class="hidden bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Riwayat & Transparansi Keuangan</h3>
                        <p class="text-xs text-slate-500">Semua entri transaksi uang masuk dan keluar. Anda dapat mencari, mengedit, atau menghapus entri.</p>
                    </div>
                    
                    <!-- Search & Filters -->
                    <div class="flex flex-wrap items-center gap-2">
                        <div class="relative flex-grow sm:flex-grow-0">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                                <i class="fas fa-search text-xs"></i>
                            </span>
                            <input type="text" id="search-history" oninput="renderHistoryTable()" placeholder="Cari nama/keterangan..." class="pl-8 pr-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500 w-full sm:w-44">
                        </div>
                        <div>
                            <select id="filter-status" onchange="renderHistoryTable()" class="px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                <option value="ALL">Semua Jenis / Status</option>
                                <option value="Lunas">Kas Lunas</option>
                                <option value="Belum Lunas">Kas Belum Lunas</option>
                                <option value="PENGELUARAN">Khusus Pengeluaran</option>
                            </select>
                        </div>
                        <div class="flex items-center space-x-1">
                            <input type="date" id="filter-date" onchange="renderHistoryTable()" class="px-2 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            <button onclick="clearDateFilter()" title="Hapus Filter Tanggal" class="text-slate-400 hover:text-slate-600 px-1 text-xs font-bold">×</button>
                        </div>
                    </div>
                </div>

                <!-- Table -->
                <div class="overflow-x-auto border border-slate-200 rounded-xl">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-100 text-slate-700 text-xs font-bold uppercase tracking-wider">
                                <th class="p-3 border-b">No</th>
                                <th class="p-3 border-b">Tanggal</th>
                                <th class="p-3 border-b">Tipe / Kategori</th>
                                <th class="p-3 border-b">Nama / Keterangan</th>
                                <th class="p-3 border-b">Nominal</th>
                                <th class="p-3 border-b">Status</th>
                                <th class="p-3 border-b text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="history-table-body" class="text-xs divide-y divide-slate-100 text-slate-700">
                            <!-- Populated by JS -->
                        </tbody>
                    </table>
                </div>
            </div>


            <!-- TAB 3: REKAP ABSENSI MINGGUAN & GENERATOR WA -->
            <div id="tab-content-rekap" class="hidden bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900">Rekapitulasi Kepatuhan Bayar Kas</h3>
                        <p class="text-xs text-slate-500">Matriks kedisiplinan absensi kas mahasiswa per minggu.</p>
                    </div>

                    <div class="flex items-center space-x-2">
                        <label class="text-xs font-semibold text-slate-600">Pilih Bulan:</label>
                        <input type="month" id="rekap-month" onchange="renderRekapTable()" class="px-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-xs font-semibold">
                    </div>
                </div>

                <!-- Rekap Table -->
                <div class="overflow-x-auto border border-slate-200 rounded-xl">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-100 text-slate-700 text-xs font-bold uppercase tracking-wider">
                                <th class="p-3 border-b">No</th>
                                <th class="p-3 border-b">Nama Mahasiswa</th>
