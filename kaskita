    <!-- JAVASCRIPT APP LOGIC -->
    <script>
        // LOCALSTORAGE KEYS
        const STORAGE_KEY_USERS = 'kaskita_users';
        const STORAGE_KEY_CURRENT_USER = 'kaskita_current_user';
        const STORAGE_KEY_STUDENTS = 'kaskita_students';
        const STORAGE_KEY_KAS = 'kaskita_kas_data';

        const defaultStudents = [
            "Ahmad Fauzi", "Budi Santoso", "Citra Dewi", "Dian Sastro",
            "Eko Prasetyo", "Fani Fitriani", "Gilang Ramadhan", "Hany Puspita"
        ];

        let currentUser = null;
        let students = [];
        let kasTransactions = [];

        document.addEventListener('DOMContentLoaded', () => {
            loadInitialData();
            checkAuthSession();

            const today = new Date().toISOString().split('T')[0];
            const inputDate = document.getElementById('input-date');
            const expDate = document.getElementById('expense-date');
            if (inputDate) inputDate.value = today;
            if (expDate) expDate.value = today;

            const now = new Date();
            const rekapMonthInput = document.getElementById('rekap-month');
            if (rekapMonthInput) {
                const ym = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
                rekapMonthInput.value = ym;
            }
        });

        function loadInitialData() {
            const savedStudents = localStorage.getItem(STORAGE_KEY_STUDENTS);
            if (savedStudents) {
                students = JSON.parse(savedStudents);
            } else {
                students = [...defaultStudents];
                saveStudents();
            }

            const savedKas = localStorage.getItem(STORAGE_KEY_KAS);
            if (savedKas) {
                kasTransactions = JSON.parse(savedKas);
            }
        }

        function saveStudents() {
            localStorage.setItem(STORAGE_KEY_STUDENTS, JSON.stringify(students));
        }

        function saveKasTransactions() {
            localStorage.setItem(STORAGE_KEY_KAS, JSON.stringify(kasTransactions));
        }

        function checkAuthSession() {
            const savedUser = localStorage.getItem(STORAGE_KEY_CURRENT_USER);
            if (savedUser) {
                currentUser = JSON.parse(savedUser);
                showQuotesPage();
            } else {
                showAuthPage();
            }
        }

        function switchAuthMode(mode) {
            const formLogin = document.getElementById('form-login');
            const formRegister = document.getElementById('form-register');
            const authTitle = document.getElementById('auth-title');
            const authSubtitle = document.getElementById('auth-subtitle');
            const toggleText = document.getElementById('toggle-auth-text');

            if (mode === 'register') {
                formLogin.classList.add('hidden');
                formRegister.classList.remove('hidden');
                authTitle.innerText = 'Daftar Bendahara';
                authSubtitle.innerText = 'Buat akun pengelola baru';
                toggleText.innerHTML = `Sudah punya akun? <button type="button" onclick="switchAuthMode('login')" class="text-emerald-600 font-bold hover:underline">Masuk di sini</button>`;
            } else {
                formRegister.classList.add('hidden');
                formLogin.classList.remove('hidden');
                authTitle.innerText = 'Login Bendahara';
                authSubtitle.innerText = 'Masuk untuk mengelola keuangan kelas';
                toggleText.innerHTML = `Belum punya akun? <button type="button" onclick="switchAuthMode('register')" class="text-emerald-600 font-bold hover:underline">Daftar Akun</button>`;
            }
        }

        function handleRegister(e) {
            e.preventDefault();
            const name = document.getElementById('reg-name').value.trim();
            const username = document.getElementById('reg-user').value.trim();
            const pass = document.getElementById('reg-pass').value;

            let users = JSON.parse(localStorage.getItem(STORAGE_KEY_USERS) || '[]');
            if (users.some(u => u.username === username)) {
                showToast('Username sudah terdaftar!', 'error');
                return;
            }

            const newUser = { name, username, pass };
            users.push(newUser);
            localStorage.setItem(STORAGE_KEY_USERS, JSON.stringify(users));

            currentUser = newUser;
            localStorage.setItem(STORAGE_KEY_CURRENT_USER, JSON.stringify(currentUser));
            showToast('Registrasi akun berhasil!');
            showQuotesPage();
        }

        function handleLogin(e) {
            e.preventDefault();
            const username = document.getElementById('login-user').value.trim();
            const pass = document.getElementById('login-pass').value;

            let users = JSON.parse(localStorage.getItem(STORAGE_KEY_USERS) || '[]');
            const userMatch = users.find(u => u.username === username && u.pass === pass);

            if (userMatch) {
                currentUser = userMatch;
                localStorage.setItem(STORAGE_KEY_CURRENT_USER, JSON.stringify(currentUser));
                showToast('Login berhasil!');
                showQuotesPage();
            } else {
                showToast('Username atau password salah!', 'error');
            }
        }

        function handleLogout() {
            localStorage.removeItem(STORAGE_KEY_CURRENT_USER);
            currentUser = null;
            showAuthPage();
            showToast('Anda telah keluar.');
        }

        function showAuthPage() {
            document.getElementById('page-auth').classList.remove('hidden');
            document.getElementById('page-quotes').classList.add('hidden');
            document.getElementById('page-dashboard').classList.add('hidden');
            document.getElementById('main-header').classList.add('hidden');
            document.getElementById('main-footer').classList.add('hidden');
        }

        function showQuotesPage() {
            document.getElementById('page-auth').classList.add('hidden');
            document.getElementById('page-quotes').classList.remove('hidden');
            document.getElementById('page-dashboard').classList.add('hidden');
            document.getElementById('main-header').classList.add('hidden');
            document.getElementById('main-footer').classList.add('hidden');

            document.getElementById('welcome-user-text').innerText = `Selamat Datang, ${currentUser ? currentUser.name : 'Bendahara'}!`;
        }

        function goToDashboard() {
            document.getElementById('page-quotes').classList.add('hidden');
            document.getElementById('page-dashboard').classList.remove('hidden');
            document.getElementById('main-header').classList.remove('hidden');
            document.getElementById('main-footer').classList.remove('hidden');

            if (currentUser) {
                document.getElementById('nav-username').innerText = currentUser.name;
            }

            renderDashboard();
        }

        function renderDashboard() {
            updateStats();
            renderCheckboxStudentList();
            renderHistoryTable();
            renderRekapTable();
            renderStudentDirectory();
            generateWaMessage();
        }

        function switchTab(tabName) {
            const tabs = ['input', 'history', 'rekap', 'students'];
            tabs.forEach(t => {
                const content = document.getElementById(`tab-content-${t}`);
                const btn = document.getElementById(`tab-btn-${t}`);
                if (!content || !btn) return;
                if (t === tabName) {
                    content.classList.remove('hidden');
                    btn.className = "px-4 py-2.5 rounded-xl font-semibold text-xs transition-all flex items-center space-x-2 bg-emerald-600 text-white shadow-md";
                } else {
                    content.classList.add('hidden');
                    btn.className = "px-4 py-2.5 rounded-xl font-semibold text-xs transition-all flex items-center space-x-2 text-slate-600 hover:bg-slate-100";
                }
            });
        }

        function updateStats() {
            document.getElementById('stat-total-students').innerText = `${students.length} Mahasiswa`;
            
            const totalIncome = kasTransactions
                .filter(t => t.type !== 'EXPENSE' && t.status === 'Lunas')
                .reduce((acc, c) => acc + (Number(c.nominal) || 0), 0);

            const totalExpense = kasTransactions
                .filter(t => t.type === 'EXPENSE')
                .reduce((acc, c) => acc + (Number(c.nominal) || 0), 0);

            const netBalance = totalIncome - totalExpense;

            document.getElementById('stat-total-income').innerText = `Rp ${totalIncome.toLocaleString('id-ID')}`;
            document.getElementById('stat-total-expense').innerText = `Rp ${totalExpense.toLocaleString('id-ID')}`;
            document.getElementById('stat-total-balance').innerText = `Rp ${netBalance.toLocaleString('id-ID')}`;
        }

        function toggleEntryTypeMode() {
            const selected = document.querySelector('input[name="entry-type"]:checked').value;
            const containerIncome = document.getElementById('form-container-income');
            const containerExpense = document.getElementById('form-container-expense');

            if (selected === 'EXPENSE') {
                containerIncome.classList.add('hidden');
                containerExpense.classList.remove('hidden');
            } else {
                containerExpense.classList.add('hidden');
                containerIncome.classList.remove('hidden');
            }
        }

        function renderCheckboxStudentList() {
            const container = document.getElementById('student-checkbox-container');
            if (!container) return;
            container.innerHTML = '';

            if (students.length === 0) {
                container.innerHTML = `<p class="col-span-full text-center text-slate-400 py-4 text-xs">Belum ada anggota kelas.</p>`;
                return;
            }

            students.forEach((name, index) => {
                const card = document.createElement('label');
                card.className = "flex items-center justify-between p-3 bg-slate-50 hover:bg-emerald-50/50 rounded-xl border border-slate-200 cursor-pointer transition-all select-none";
                card.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <input type="checkbox" value="${name}" class="student-chk rounded border-slate-300 text-emerald-600 focus:ring-emerald-500 h-4 w-4">
                        <span class="text-xs font-semibold text-slate-700">${index + 1}. ${name}</span>
                    </div>
                    <span class="text-[10px] bg-slate-200 text-slate-600 font-bold px-2 py-0.5 rounded-full status-tag">Belum Lunas</span>
                `;

                const chk = card.querySelector('input');
                const tag = card.querySelector('.status-tag');
                chk.addEventListener('change', (e) => {
                    if (e.target.checked) {
                        tag.className = "text-[10px] bg-emerald-100 text-emerald-700 font-bold px-2 py-0.5 rounded-full status-tag";
                        tag.innerText = "LUNAS";
                    } else {
                        tag.className = "text-[10px] bg-slate-200 text-slate-600 font-bold px-2 py-0.5 rounded-full status-tag";
                        tag.innerText = "Belum Lunas";
                    }
                });

                container.appendChild(card);
            });
        }

        function toggleSelectAllStudents(select) {
            const checkboxes = document.querySelectorAll('.student-chk');
            checkboxes.forEach(chk => {
                chk.checked = select;
                chk.dispatchEvent(new Event('change'));
            });
        }

        function saveBatchKas() {
            const dateVal = document.getElementById('input-date').value;
            const nominalDefault = Number(document.getElementById('input-nominal-default').value) || 0;

            if (!dateVal) {
                showToast('Pilih tanggal kas terlebih dahulu!', 'error');
                return;
            }

            const checkboxes = document.querySelectorAll('.student-chk');
            let newEntriesCount = 0;

            checkboxes.forEach(chk => {
                const name = chk.value;
                const isPaid = chk.checked;
                
                kasTransactions.unshift({
                    id: 'trx_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6),
                    date: dateVal,
                    name: name,
                    nominal: isPaid ? nominalDefault : 0,
                    type: 'INCOME',
                    status: isPaid ? 'Lunas' : 'Belum Lunas'
                });
                newEntriesCount++;
            });

            saveKasTransactions();
            renderDashboard();
            showToast(`Berhasil menyimpan ${newEntriesCount} data kas baru!`);
            toggleSelectAllStudents(false);
        }

        function handleSaveExpense(e) {
            e.preventDefault();
            const date = document.getElementById('expense-date').value;
            const category = document.getElementById('expense-category').value;
            const nominal = Number(document.getElementById('expense-nominal').value) || 0;
            const note = document.getElementById('expense-note').value.trim();

            if (!date || nominal <= 0 || !note) {
                showToast('Lengkapi data pengeluaran dengan benar!', 'error');
                return;
            }

            kasTransactions.unshift({
                id: 'trx_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6),
                date: date,
                name: `[${category}] ${note}`,
                nominal: nominal,
                type: 'EXPENSE',
                status: 'PENGELUARAN'
            });

            saveKasTransactions();
            renderDashboard();
            document.getElementById('expense-note').value = '';
            document.getElementById('expense-nominal').value = '';
            showToast('Pengeluaran kas berhasil dicatat!');
        }

        function clearDateFilter() {
            document.getElementById('filter-date').value = '';
            renderHistoryTable();
        }

        function renderHistoryTable() {
            const tbody = document.getElementById('history-table-body');
            if (!tbody) return;
            tbody.innerHTML = '';

            const searchVal = document.getElementById('search-history').value.toLowerCase();
            const filterStatus = document.getElementById('filter-status').value;
            const filterDate = document.getElementById('filter-date').value;

            const filteredData = kasTransactions.filter(item => {
                const matchName = item.name.toLowerCase().includes(searchVal);
                const matchStatus = (filterStatus === 'ALL') || 
                                    (filterStatus === 'PENGELUARAN' && item.type === 'EXPENSE') || 
                                    (item.status === filterStatus);
                const matchDate = (!filterDate) || (item.date === filterDate);
                return matchName && matchStatus && matchDate;
            });

            if (filteredData.length === 0) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-slate-400 italic">Tidak ada transaksi yang cocok.</td></tr>`;
                return;
            }

            filteredData.forEach((item, idx) => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50/80 transition-colors";

                const isExpense = item.type === 'EXPENSE';
                const isLunas = item.status === 'Lunas';

                let badge = '';
                if (isExpense) {
                    badge = `<span class="bg-rose-100 text-rose-800 font-bold px-2.5 py-1 rounded-full text-[10px]"><i class="fas fa-arrow-up mr-1"></i>Pengeluaran</span>`;
                } else if (isLunas) {
                    badge = `<span class="bg-emerald-100 text-emerald-800 font-bold px-2.5 py-1 rounded-full text-[10px]"><i class="fas fa-check-circle mr-1"></i>Lunas</span>`;
                } else {
                    badge = `<span class="bg-amber-100 text-amber-800 font-bold px-2.5 py-1 rounded-full text-[10px]"><i class="fas fa-times-circle mr-1"></i>Belum Lunas</span>`;
                }

                const typeLabel = isExpense ? `<span class="text-rose-600 font-bold">Pengeluaran</span>` : `<span class="text-emerald-600 font-bold">Pemasukan Kas</span>`;

                tr.innerHTML = `
                    <td class="p-3 text-slate-500 font-medium">${idx + 1}</td>
                    <td class="p-3 font-semibold text-slate-700">${item.date}</td>
                    <td class="p-3">${typeLabel}</td>
                    <td class="p-3 font-bold text-slate-900">${item.name}</td>
                    <td class="p-3 font-semibold ${isExpense ? 'text-rose-600' : 'text-slate-700'}">Rp ${(Number(item.nominal) || 0).toLocaleString('id-ID')}</td>
                    <td class="p-3">${badge}</td>
                    <td class="p-3 text-center space-x-1">
                        <button onclick="openEditTrxModal('${item.id}')" class="p-1.5 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg transition-colors" title="Edit Transaksi">
                            <i class="fas fa-pencil-alt"></i>
                        </button>
                        <button onclick="deleteKasEntry('${item.id}')" class="p-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 rounded-lg transition-colors" title="Hapus Transaksi">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function openEditTrxModal(trxId) {
            const trx = kasTransactions.find(t => t.id === trxId);
            if (!trx) return;

            document.getElementById('edit-trx-id').value = trx.id;
            document.getElementById('edit-trx-name').value = trx.name;
            document.getElementById('edit-trx-date').value = trx.date;
            document.getElementById('edit-trx-nominal').value = trx.nominal;
            document.getElementById('edit-trx-status').value = trx.status;

            document.getElementById('modal-edit-trx').classList.remove('hidden');
        }

        function closeEditTrxModal() {
            document.getElementById('modal-edit-trx').classList.add('hidden');
        }

        function handleSaveEditTrx(e) {
            e.preventDefault();
            const id = document.getElementById('edit-trx-id').value;
            const name = document.getElementById('edit-trx-name').value.trim();
            const date = document.getElementById('edit-trx-date').value;
            const nominal = Number(document.getElementById('edit-trx-nominal').value) || 0;
            const status = document.getElementById('edit-trx-status').value;

            const idx = kasTransactions.findIndex(t => t.id === id);
            if (idx !== -1) {
                const type = status === 'PENGELUARAN' ? 'EXPENSE' : 'INCOME';
                kasTransactions[idx] = { id, name, date, nominal, status, type };
                saveKasTransactions();
                renderDashboard();
                closeEditTrxModal();
                showToast('Transaksi berhasil diperbarui!');
            }
        }

        function deleteKasEntry(id) {
            if (confirm('Yakin menghapus data transaksi ini?')) {
                kasTransactions = kasTransactions.filter(t => t.id !== id);
                saveKasTransactions();
                renderDashboard();
                showToast('Transaksi berhasil dihapus.');
            }
        }

        function renderRekapTable() {
            const tbody = document.getElementById('rekap-table-body');
            if (!tbody) return;
            tbody.innerHTML = '';

            const monthVal = document.getElementById('rekap-month').value; // e.g. "2026-11"

            students.forEach((name, idx) => {
                const studentTrx = kasTransactions.filter(t => t.name === name && t.date.startsWith(monthVal));
                
                const w1 = studentTrx.some(t => {
                    const day = parseInt(t.date.split('-')[2]);
                    return day >= 1 && day <= 7 && t.status === 'Lunas';
                });
                const w2 = studentTrx.some(t => {
                    const day = parseInt(t.date.split('-')[2]);
                    return day >= 8 && day <= 14 && t.status === 'Lunas';
                });
                const w3 = studentTrx.some(t => {
                    const day = parseInt(t.date.split('-')[2]);
                    return day >= 15 && day <= 21 && t.status === 'Lunas';
                });
                const w4 = studentTrx.some(t => {
                    const day = parseInt(t.date.split('-')[2]);
                    return day >= 22 && t.status === 'Lunas';
                });

                const countPaid = [w1, w2, w3, w4].filter(Boolean).length;
                const percentage = Math.round((countPaid / 4) * 100);

                const iconCheck = `<i class="fas fa-check text-emerald-600 font-bold"></i>`;
                const iconCross = `<i class="fas fa-times text-rose-400"></i>`;

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition-colors";
                tr.innerHTML = `
                    <td class="p-3 text-slate-500 font-medium">${idx + 1}</td>
                    <td class="p-3 font-bold text-slate-900">${name}</td>
                    <td class="p-3 text-center">${w1 ? iconCheck : iconCross}</td>
                    <td class="p-3 text-center">${w2 ? iconCheck : iconCross}</td>
                    <td class="p-3 text-center">${w3 ? iconCheck : iconCross}</td>
                    <td class="p-3 text-center">${w4 ? iconCheck : iconCross}</td>
                    <td class="p-3 text-center">
                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold ${percentage === 100 ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'}">
                            ${percentage}% (${countPaid}/4)
                        </span>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function generateWaMessage() {
            const tone = document.getElementById('wa-tone').value;
            const unpaidList = kasTransactions
                .filter(t => t.type !== 'EXPENSE' && t.status === 'Belum Lunas')
                .map(t => t.name);

            const uniqueUnpaid = [...new Set(unpaidList)];

            let msg = "";
            if (tone === 'SANTAI') {
                msg = `Halo teman-teman! 🖐🏻\nSekadar mengingatkan untuk pembayaran kas kelas minggu ini ya. Bagi yang belum lunas:\n`;
                uniqueUnpaid.forEach((n, i) => msg += `${i + 1}. ${n}\n`);
                msg += `\nBisa langsung bayar ke bendahara ya. Terima kasih! 🙏🏻`;
            } else if (tone === 'TEGAS') {
                msg = `[PEMBERITAHUAN PENTING KAS KELAS]\nMohon perhatian bagi nama-nama berikut yang masih memiliki tunggakan kas kelas:\n`;
                uniqueUnpaid.forEach((n, i) => msg += `${i + 1}. ${n}\n`);
                msg += `\nDiharapkan segera melunasi pembayaran paling lambat akhir minggu ini untuk transparansi keuangan kelas. Terima kasih.`;
            } else {
                msg = `Assalamu’alaikum / Selamat Pagi teman-teman 🙏\nBerikut kami lampirkan daftar mahasiswa yang belum melunasi kas kelas minggu ini:\n\n`;
                uniqueUnpaid.forEach((n, i) => msg += `${i + 1}. ${n}\n`);
                msg += `\nMohon kesediaannya untuk segera menyetorkan ke bendahara kelas demi kelancaran kegiatan bersama. Terima kasih atas kerja samanya. 😊`;
            }

            document.getElementById('wa-preview').value = msg;
        }

        function copyWaMessage() {
            const txt = document.getElementById('wa-preview');
            txt.select();
            document.execCommand('copy');
            showToast('Teks tagihan WA berhasil disalin!');
        }

        function sendWaMessage() {
            const text = encodeURIComponent(document.getElementById('wa-preview').value);
            window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
        }

        function handleAddStudent(e) {
            e.preventDefault();
            const input = document.getElementById('new-student-name');
            const name = input.value.trim();

            if (!name) return;
            if (students.includes(name)) {
                showToast('Nama ini sudah terdaftar!', 'error');
                return;
            }

            students.push(name);
            saveStudents();
            input.value = '';
            renderDashboard();
            showToast('Anggota kelas berhasil ditambahkan!');
        }

        function renderStudentDirectory() {
            const list = document.getElementById('student-directory-list');
            const countBadge = document.getElementById('student-count-badge');
            
            if (countBadge) countBadge.innerText = `${students.length} Mahasiswa`;
            if (!list) return;

            list.innerHTML = '';
            students.forEach((name, index) => {
                const div = document.createElement('div');
                div.className = "flex items-center justify-between p-3 bg-slate-50 border border-slate-200 rounded-xl";
                div.innerHTML = `
                    <div class="flex items-center space-x-2">
                        <span class="text-xs font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md">${index + 1}</span>
                        <span class="text-xs font-semibold text-slate-700">${name}</span>
                    </div>
                    <div class="flex items-center space-x-1">
                        <button onclick="openEditStudentModal('${name}')" class="p-1.5 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg text-xs transition-colors" title="Edit Nama">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button onclick="deleteStudent('${name}')" class="p-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 rounded-lg text-xs transition-colors" title="Hapus Anggota">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>
                `;
                list.appendChild(div);
            });
        }

        function openEditStudentModal(oldName) {
            document.getElementById('edit-student-old-name').value = oldName;
            document.getElementById('edit-student-new-name').value = oldName;
            document.getElementById('modal-edit-student').classList.remove('hidden');
        }

        function closeEditStudentModal() {
            document.getElementById('modal-edit-student').classList.add('hidden');
        }

        function handleSaveEditStudent(e) {
            e.preventDefault();
            const oldName = document.getElementById('edit-student-old-name').value;
            const newName = document.getElementById('edit-student-new-name').value.trim();

            if (!newName) return;
            const idx = students.indexOf(oldName);
            if (idx !== -1) {
                students[idx] = newName;
                saveStudents();
                kasTransactions.forEach(t => { if (t.name === oldName) t.name = newName; });
                saveKasTransactions();
                renderDashboard();
                closeEditStudentModal();
                showToast('Nama mahasiswa berhasil diubah!');
            }
        }

        function deleteStudent(name) {
            if (confirm(`Hapus "${name}" dari daftar kelas?`)) {
                students = students.filter(s => s !== name);
                saveStudents();
                renderDashboard();
                showToast('Anggota berhasil dihapus.');
            }
        }

        function openExportModal() {
            if (kasTransactions.length === 0) {
                showToast('Belum ada data untuk diekspor!', 'error');
                return;
            }

            const totalCount = kasTransactions.length;
            const totalIncome = kasTransactions
                .filter(t => t.type !== 'EXPENSE' && t.status === 'Lunas')
                .reduce((acc, c) => acc + (Number(c.nominal) || 0), 0);
            const totalExpense = kasTransactions
                .filter(t => t.type === 'EXPENSE')
                .reduce((acc, c) => acc + (Number(c.nominal) || 0), 0);

            document.getElementById('export-summary-count').innerText = `${totalCount} Entri Transaksi`;
            document.getElementById('export-summary-income').innerText = `Rp ${totalIncome.toLocaleString('id-ID')}`;
            document.getElementById('export-summary-expense').innerText = `Rp ${totalExpense.toLocaleString('id-ID')}`;

            const chk = document.getElementById('chk-export-verify');
            chk.checked = false;
            toggleExportButton();

            document.getElementById('modal-export').classList.remove('hidden');
        }

        function closeExportModal() {
            document.getElementById('modal-export').classList.add('hidden');
        }

        function toggleExportButton() {
            const chk = document.getElementById('chk-export-verify');
            const btn = document.getElementById('btn-do-export');

            if (chk.checked) {
                btn.disabled = false;
                btn.className = "px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-all shadow-lg shadow-emerald-200 cursor-pointer flex items-center justify-center space-x-2";
            } else {
                btn.disabled = true;
                btn.className = "px-6 py-2.5 rounded-xl bg-slate-300 text-slate-500 cursor-not-allowed text-xs font-bold transition-all shadow-md flex items-center justify-center space-x-2";
            }
        }

        function executeDirectExcelExport() {
            try {
                // Sheet 1: Transaksi
                const rows1 = kasTransactions.map((t, idx) => ({
                    "No": idx + 1,
                    "Tanggal": t.date,
                    "Tipe Transaksi": t.type === 'EXPENSE' ? 'Pengeluaran' : 'Pemasukan',
                    "Nama / Keterangan": t.name,
                    "Nominal (Rp)": Number(t.nominal) || 0,
                    "Status": t.status
                }));
                const ws1 = XLSX.utils.json_to_sheet(rows1);
                ws1['!cols'] = [{ wch: 6 }, { wch: 14 }, { wch: 16 }, { wch: 30 }, { wch: 15 }, { wch: 16 }];

                // Sheet 2: Rekap Absensi
                const monthVal = document.getElementById('rekap-month').value;
                const rows2 = students.map((name, idx) => {
                    const studentTrx = kasTransactions.filter(t => t.name === name && t.date.startsWith(monthVal));
                    const w1 = studentTrx.some(t => parseInt(t.date.split('-')[2]) <= 7 && t.status === 'Lunas');
                    const w2 = studentTrx.some(t => parseInt(t.date.split('-')[2]) >= 8 && parseInt(t.date.split('-')[2]) <= 14 && t.status === 'Lunas');
                    const w3 = studentTrx.some(t => parseInt(t.date.split('-')[2]) >= 15 && parseInt(t.date.split('-')[2]) <= 21 && t.status === 'Lunas');
                    const w4 = studentTrx.some(t => parseInt(t.date.split('-')[2]) >= 22 && t.status === 'Lunas');
                    
                    return {
                        "No": idx + 1,
                        "Nama Mahasiswa": name,
                        "Minggu 1": w1 ? 'LUNAS' : 'BELUM',
                        "Minggu 2": w2 ? 'LUNAS' : 'BELUM',
                        "Minggu 3": w3 ? 'LUNAS' : 'BELUM',
                        "Minggu 4": w4 ? 'LUNAS' : 'BELUM',
                    };
                });
                const ws2 = XLSX.utils.json_to_sheet(rows2);

                const workbook = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(workbook, ws1, "Riwayat Transaksi");
                XLSX.utils.book_append_sheet(workbook, ws2, "Rekap Presensi Kas");

                const dateStr = new Date().toISOString().split('T')[0];
                XLSX.writeFile(workbook, `KasKita_Laporan_${dateStr}.xlsx`);

                closeExportModal();
                showToast("File Excel (.xlsx) berhasil diunduh!");
            } catch (err) {
                console.error(err);
                showToast("Gagal mengunduh Excel: " + err.message, "error");
            }
        }

        function showToast(msg, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-msg');
            const toastIcon = document.getElementById('toast-icon');

            toastMsg.innerText = msg;
            if (type === 'error') {
                toastIcon.className = "inline-flex items-center justify-center flex-shrink-0 w-10 h-10 text-rose-500 bg-rose-100 rounded-lg";
                toastIcon.innerHTML = `<i class="fas fa-exclamation-circle text-lg"></i>`;
            } else {
                toastIcon.className = "inline-flex items-center justify-center flex-shrink-0 w-10 h-10 text-emerald-500 bg-emerald-100 rounded-lg";
                toastIcon.innerHTML = `<i class="fas fa-check-circle text-lg"></i>`;
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3500);
        }
    </script>
</body>
</html>
